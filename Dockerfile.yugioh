# Dockerfile for pulling from Git repository
FROM node:18-alpine AS builder

# Install git
RUN apk add --no-cache git

# Set working directory
WORKDIR /app

# Clone the repository
ARG GIT_REPO=https://github.com/chappomann/yugioh.git
ARG GIT_BRANCH=develop
RUN git clone --depth 1 --branch ${GIT_BRANCH} ${GIT_REPO} .

# Install dependencies for the monorepo (installs both backend and frontend)
RUN npm run install

# Build both backend and frontend
RUN npm run build

# Production stage
FROM node:18-alpine AS production

WORKDIR /app

# Install git and wget for health checks
RUN apk add --no-cache git wget

# Create non-root user FIRST (before copying files)
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Copy built files with correct ownership from the start
COPY --from=builder --chown=nextjs:nodejs /app/backend/dist ./dist
COPY --from=builder --chown=nextjs:nodejs /app/frontend/dist ./frontend/dist
COPY --from=builder --chown=nextjs:nodejs /app/backend/package*.json ./
COPY --from=builder --chown=nextjs:nodejs /app/backend/.env.production ./.env
COPY --from=builder --chown=nextjs:nodejs /app/backend/database ./database

# Install only production dependencies
USER root
RUN npm ci --only=production && npm cache clean --force

# Create directories with correct ownership
RUN mkdir -p /app/data /app/public/images && \
    chown -R nextjs:nodejs /app/data /app/public

# Create entrypoint script with correct ownership
RUN echo '#!/bin/sh' > /app/entrypoint.sh && \
    echo 'echo "Starting Yu-Gi-Oh application..."' >> /app/entrypoint.sh && \
    echo '' >> /app/entrypoint.sh && \
    echo '# Check if database exists, if not initialize' >> /app/entrypoint.sh && \
    echo 'if [ ! -f "/app/data/yugioh.sqlite" ]; then' >> /app/entrypoint.sh && \
    echo '    echo "Database not found, initializing..."' >> /app/entrypoint.sh && \
    echo '    npm run seed' >> /app/entrypoint.sh && \
    echo '    echo "Database initialization completed"' >> /app/entrypoint.sh && \
    echo 'fi' >> /app/entrypoint.sh && \
    echo '' >> /app/entrypoint.sh && \
    echo '# Start the application' >> /app/entrypoint.sh && \
    echo 'exec npm start' >> /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh && \
    chown nextjs:nodejs /app/entrypoint.sh

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

# Start the application
CMD ["/app/entrypoint.sh"]