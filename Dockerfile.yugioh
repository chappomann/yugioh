# Dockerfile for pulling from Git repository
FROM node:18-alpine AS builder

# Install git
RUN apk add --no-cache git

# Set working directory
WORKDIR /app

# Clone the repository
ARG GIT_REPO=https://github.com/chappomann/yugioh.git
ARG GIT_BRANCH=develop
RUN git clone --depth 1 --branch ${GIT_BRANCH} ${GIT_REPO} .

# Install dependencies for both frontend and backend
RUN npm install
RUN npm run build

# Production stage
FROM node:18-alpine AS production

WORKDIR /app

# Install git (needed for potential runtime operations)
RUN apk add --no-cache git wget

# Copy package.json and install production dependencies
COPY --from=builder /app/backend/package*.json ./
RUN npm ci --only=production && \
    npm install tsx && \
    npm cache clean --force

# Copy built backend from builder stage
COPY --from=builder /app/backend/dist ./dist

# Copy built frontend to both expected locations
COPY --from=builder /app/frontend/dist ./frontend/dist
COPY --from=builder /app/frontend/dist ./public

# Copy environment files
COPY --from=builder /app/backend/.env.production ./.env

# Copy database directory (if needed)
COPY --from=builder /app/backend/database ./database

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Create directories and set permissions
RUN mkdir -p /app/data /app/public/images && \
    chown -R nextjs:nodejs /app

# Create entrypoint script - fixed syntax
RUN echo '#!/bin/sh' > /app/entrypoint.sh && \
    echo 'echo "Starting Yu-Gi-Oh application..."' >> /app/entrypoint.sh && \
    echo '' >> /app/entrypoint.sh && \
    echo '# Check if database exists, if not initialize' >> /app/entrypoint.sh && \
    echo 'if [ ! -f "/app/data/yugioh.sqlite" ]; then' >> /app/entrypoint.sh && \
    echo '    echo "Database not found, initializing..."' >> /app/entrypoint.sh && \
    echo '    npm run docker:setup' >> /app/entrypoint.sh && \
    echo '    echo "Database initialization completed"' >> /app/entrypoint.sh && \
    echo 'fi' >> /app/entrypoint.sh && \
    echo '' >> /app/entrypoint.sh && \
    echo '# Start the application' >> /app/entrypoint.sh && \
    echo 'exec npm start' >> /app/entrypoint.sh

RUN chmod +x /app/entrypoint.sh && \
    chown nextjs:nodejs /app/entrypoint.sh

# Change ownership of app directory
USER nextjs

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

# Start the application
CMD ["/app/entrypoint.sh"]